# Copy to .env and adjust. All values below are safe development defaults.

# PostgreSQL connection (docker compose up -d, or a local postgres service)
DATABASE_URL="postgresql://omerta:omerta_dev@localhost:5432/omerta"

# 32+ char secret for signing session JWTs — rotate in production
SESSION_SECRET="dev-session-secret-change-me-0123456789abcdef"

# AES-256-GCM key (hex, exactly 32 bytes) for encrypting custodial wallet keys
WALLET_ENC_KEY="6f6d657274612d6465762d77616c6c65742d6b65792d30313233343536373839"

# Chain integration. Keep "false" until contracts are deployed and an RPC is reachable.
CHAIN_ENABLED="false"

# Sonic Blaze testnet: https://rpc.testnet.soniclabs.com (chain id 14601)
# Local hardhat node:  http://127.0.0.1:8545        (chain id 31337)
CHAIN_RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="31337"

# Private key of the treasury account holding MINTER_ROLE on OmertaToken.
# Default below = hardhat node account #0 (publicly known, local dev only!).
TREASURY_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Secret for admin endpoints (season rollover via POST /api/season/end)
ADMIN_SECRET="dev-admin-secret-omerta"
